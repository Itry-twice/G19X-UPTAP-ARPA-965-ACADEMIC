# ==========================================================================
# PluriOne — Asistente Virtual de Integración Organizacional
# Plantilla de variables de entorno. Copie a `.env` y complete los secretos.
# NUNCA suba `.env` al repositorio.
# ==========================================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=plurione
# Desarrollo: DB_ERROR_DETAIL=true  (muestra detalles de error de la BD)
# Producción: DB_ERROR_DETAIL=false (oculta detalles, recomendado)
DB_ERROR_DETAIL=true

# --- Roles de aplicación en PostgreSQL (menor privilegio) ---
SVC_AUTH_PASSWORD=CHANGE_ME_svc_auth
SVC_ONBOARDING_PASSWORD=CHANGE_ME_svc_onboarding
SVC_HR_PASSWORD=CHANGE_ME_svc_hr
SVC_AI_PASSWORD=CHANGE_ME_svc_ai

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- JWT (AuthService + servicios) ---
# Use al menos 32 bytes aleatorios. Ej: openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_random_signing_key_at_least_32_bytes_long
JWT_ISSUER=plurione-auth
JWT_AUDIENCE=plurione
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Comunicación interna entre microservicios ---
# La identidad se propaga con el JWT del usuario (firmado con JWT_SIGNING_KEY).
# No se requieren claves adicionales para el MVP.

# --- Groq (solo AI Service) ---
GROQ_API_KEY=CHANGE_ME_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# --- Embeddings ---
# 'sentence-transformers' (semántico, recomendado) o 'hash' (sin descarga, para CI)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- Web / cookies ---
# Desarrollo: ASPNETCORE_ENVIRONMENT=Development
# Producción: ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_ENVIRONMENT=Development
SESSION_COOKIE_SECURE=false
APP_BASE_URL=http://localhost

# --- Cuentas DEMO ---
# Desarrollo: SEED_DEMO=true  (crea los usuarios de demostración)
# Producción: SEED_DEMO=false (sin cuentas demo)
SEED_DEMO=true

# --- URLs internas (dentro de la red Docker) ---
AUTH_SERVICE_URL=http://auth-service:8080
ONBOARDING_SERVICE_URL=http://onboarding-service:8080
HR_SERVICE_URL=http://hr-service:8080
AI_SERVICE_URL=http://ai-service:8080

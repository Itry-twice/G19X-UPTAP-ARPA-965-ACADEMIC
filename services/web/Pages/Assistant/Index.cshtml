@page
@model PluriOne.Web.Pages.Assistant.IndexModel
@{
    ViewData["Title"] = "Asistente";
}
<div class="page-head">
    <div>
        <div class="kicker">IA + RAG</div>
        <h1>Asistente Virtual</h1>
        <p class="muted">Pregunta sobre horarios, esquema híbrido, políticas o tu integración.</p>
    </div>
</div>

<div class="card" style="display:flex; flex-direction:column; height: 60vh;">
    <div class="chat" id="chat" style="flex:1; overflow-y:auto; padding-right:4px;">
        <div class="msg system">Hola, soy tu asistente de integración. Pregúntame lo que necesites.</div>
    </div>
    <form id="chat-form" style="display:flex; gap:10px; margin-top:16px; border-top:2px solid var(--ink); padding-top:16px;">
        <input id="chat-input" class="input" type="text" maxlength="2000" placeholder="Escribe tu pregunta…" autocomplete="off" />
        <button id="chat-send" class="btn btn-primary" type="submit">Enviar</button>
    </form>
</div>

@section Scripts {
<script>
(function () {
  const chat = document.getElementById('chat');
  const form = document.getElementById('chat-form');
  const input = document.getElementById('chat-input');
  const sendBtn = document.getElementById('chat-send');

  function addMessage(role, text) {
    const msg = el('div', 'msg ' + role);
    const who = el('div', 'who', role === 'user' ? 'Tú' : 'Asistente');
    const content = el('div', 'content');
    content.appendChild(renderContent(text));
    msg.appendChild(who);
    msg.appendChild(content);
    chat.appendChild(msg);
    chat.scrollTop = chat.scrollHeight;
    return content;
  }

  function inlineMd(text) {
    return escapeHtml(text).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  }

  function parseRow(line) {
    return line.replace(/^\|/, '').replace(/\|$/, '').split('|').map(function (c) { return c.trim(); });
  }

  function isTableSeparator(line) {
    return /^[\s|:-]+$/.test(line) && line.indexOf('-') !== -1;
  }

  function renderTable(header, rows) {
    const table = el('table', 'chat-table');
    const thead = el('thead');
    const trh = el('tr');
    header.forEach(function (h) {
      const th = el('th');
      th.innerHTML = inlineMd(h);
      trh.appendChild(th);
    });
    thead.appendChild(trh);
    table.appendChild(thead);
    const tbody = el('tbody');
    rows.forEach(function (r) {
      const tr = el('tr');
      r.forEach(function (c) {
        const td = el('td');
        td.innerHTML = inlineMd(c);
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
    });
    table.appendChild(tbody);
    return table;
  }

  function renderContent(text) {
    const frag = document.createDocumentFragment();
    const lines = text.split('\n');
    let i = 0;
    while (i < lines.length) {
      const line = lines[i];
      const trimmed = line.trim();
      if (trimmed === '') { i++; continue; }

      if (trimmed.indexOf('\t') !== -1 && i + 1 < lines.length && lines[i + 1].trim().indexOf('\t') !== -1) {
        const header = trimmed.split('\t').map(function (c) { return c.trim(); });
        const rows = [];
        i += 1;
        while (i < lines.length && lines[i].trim().indexOf('\t') !== -1) {
          rows.push(lines[i].trim().split('\t').map(function (c) { return c.trim(); }));
          i++;
        }
        frag.appendChild(renderTable(header, rows));
        continue;
      }

      if (trimmed.charAt(0) === '|' && i + 1 < lines.length && isTableSeparator(lines[i + 1].trim())) {
        const header = parseRow(trimmed);
        const rows = [];
        i += 2;
        while (i < lines.length && lines[i].trim().charAt(0) === '|') {
          rows.push(parseRow(lines[i].trim()));
          i++;
        }
        frag.appendChild(renderTable(header, rows));
        continue;
      }

      if (trimmed.charAt(0) === '>') {
        const bq = el('blockquote', 'chat-quote');
        bq.innerHTML = inlineMd(trimmed.replace(/^>\s?/, ''));
        frag.appendChild(bq);
        i++;
        continue;
      }

      if (/^\s*[-*]\s+/.test(trimmed)) {
        const ul = el('ul', 'chat-list');
        while (i < lines.length && /^\s*[-*]\s+/.test(lines[i].trim())) {
          const li = el('li');
          li.innerHTML = inlineMd(lines[i].trim().replace(/^\s*[-*]\s+/, ''));
          ul.appendChild(li);
          i++;
        }
        frag.appendChild(ul);
        continue;
      }

      const p = el('p');
      p.innerHTML = inlineMd(trimmed);
      frag.appendChild(p);
      i++;
    }
    return frag;
  }

  function appendSources(content, sources) {
    if (!sources || sources.length === 0) return;
    const div = el('div', 'sources', 'Fuentes: ' + sources.join(', '));
    content.appendChild(div);
  }

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    const question = input.value.trim();
    if (!question) return;

    addMessage('user', question);
    input.value = '';
    sendBtn.disabled = true;

    const content = addMessage('assistant', '');
    const tmp = document.createElement('span');
    content.appendChild(tmp);

    try {
      const resp = await fetch('/api/assistant/stream', {
        method: 'POST',
        headers: csrfHeaders(),
        body: JSON.stringify({ question })
      });

      if (!resp.ok) {
        tmp.textContent = 'No fue posible obtener una respuesta.';
        return;
      }

      const reader = resp.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const parts = buffer.split('\n\n');
        buffer = parts.pop();
        for (const part of parts) {
          const line = part.trim();
          if (!line.startsWith('data:')) continue;
          const payload = line.slice(5).trim();
          if (!payload) continue;
          const evt = JSON.parse(payload);
          if (evt.type === 'token') {
            tmp.textContent += evt.content;
          } else if (evt.type === 'sources') {
            appendSources(content, evt.sources);
          } else if (evt.type === 'error') {
            if (!tmp.textContent) tmp.textContent = evt.message;
          }
          chat.scrollTop = chat.scrollHeight;
        }
      }
    } catch (err) {
      if (!tmp.textContent) tmp.textContent = 'Ocurrió un error al comunicarse con el asistente.';
    } finally {
      // Re-renderiza el markdown (negritas) una vez terminado el streaming
      if (tmp.textContent) {
        content.replaceChild(renderContent(tmp.textContent), tmp);
      }
      sendBtn.disabled = false;
      input.focus();
    }
  });

  input.focus();
})();
</script>
}
